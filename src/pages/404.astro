---
import Layout from '../layouts/Layout.astro';
const variants = [
  { kicker: 'REASON FOR HIM · PAGE NOT FOUND', title: '这一页，暂时不在书架上。', paragraphs: ['也许链接失效了，也许文章搬了家。', '不过，一次走错路，不必终止一场认真的追问。'], action: '返回书房继续探索', closing: '让思考，走向更深处。' },
  { kicker: 'REASON FOR HIM · PAGE NOT FOUND', title: '关于这个页面的存在，证据不足。', paragraphs: ['我们进行了审慎的调查。', '遗憾的是，目前没有找到足以证明它存在的证据。', '当然，缺乏证据不等于不存在。也许只是网址写错了。'], action: '返回首页 · 重新搜索证据' },
  { kicker: 'AN UNEXPECTED ODYSSEY', title: '看来，你还没有抵达伊萨卡。', paragraphs: ['奥德修斯花了十年才找到回家的路。', '幸运的是，你不需要。'], action: '返回故乡（首页） · 继续旅程', boat: true },
  { kicker: 'REASON FOR HIM · APORIA', title: '我唯一知道的，就是我找不到这一页。', paragraphs: ['苏格拉底大概会赞成我们诚实地承认无知。', '不过，问题还没有结束。', '接下来，我们应该去哪里寻找？'], action: '返回首页 · 继续追问', aporia: true },
  { kicker: 'REASON FOR HIM · PAGE NOT FOUND', title: '迷失的是页面，不是你。', paragraphs: ['很遗憾，这一页我们还没有找到。', '不过，这里仍有许多值得你发现的文字。'], action: '返回首页 · 探索文章', scripture: true },
  { kicker: 'DANTE · THE DARK WOOD', title: '在人生旅程的中途', paragraphs: ['但丁发现自己置身于一片幽暗的林中，因为正路已经迷失。', '你此刻或许也走到了一个陌生的路口。不过别担心，他后来遇见了向导，你也可以从这里重新找到方向。'], action: '请维吉尔带路（回首页）', dante: true },
  { kicker: 'GENESIS · A CALL IN THE GARDEN', title: '你在哪里？', quote: '耶和华神呼唤那人，对他说：“你在哪里？”', citation: '《创世记》3:9，和合本', source: 'https://www.bible.com/zh-CN/bible/compare/GEN.3.9', paragraphs: ['在伊甸园的叙事里，躲藏的是人，发出呼唤的是神。', '这一页走失了，愿你仍听见那声寻找人的呼唤。'], action: '回到起点' },
  { kicker: 'LUKE · THE ONE THAT WAS LOST', title: '九十九只都在，这一只走丢了', quote: '你们中间谁有一百只羊失去一只，不把这九十九只撇在旷野、去找那失去的羊，直到找着呢？', citation: '《路加福音》15:4，和合本', source: 'https://www.bible.com/zh-CN/bible/47/LUK.15.CUNPSS-%E4%B8%8A%E5%B8%9D', paragraphs: ['页面走丢了，我们还在找。', '至于人，牧人从不放弃。'], action: '回到羊群（首页）' },
];
---
<Layout title="页面未找到" description="这一页暂时不在书架上。返回书房，继续探索。" lang="zh" path="/404.html">
  <section class="container missing-page" id="missing-page" data-count={variants.length} aria-label="页面未找到">
    {variants.map((variant, index) => <article class="variant" data-variant={index + 1}>
      <p class="kicker">{variant.kicker}</p>
      <div class:list={['variant-heading', { 'socratic-heading': variant.aporia }]}>
        <p class:list={['error-number', { 'odyssey-number': variant.boat }]}>404</p>
        <h1>{variant.title}</h1>
      </div>
      {variant.boat && <blockquote class="homer-quote">对人而言，没有什么比故乡与双亲更亲切。<cite>——荷马《奥德赛》第九卷，本站意译 · <a href="https://classics.mit.edu/Homer/odyssey.9.ix.html">阅读原文译本 ↗</a></cite></blockquote>}
      {variant.scripture && <blockquote>有一只羊走失了，牧人就去寻找，直到找着。<cite>——《路加福音》15:4，意译</cite></blockquote>}
      {variant.quote && <blockquote>{variant.quote}<cite>——{variant.citation} · <a href={variant.source}>阅读经文 ↗</a></cite></blockquote>}
      {variant.paragraphs.map(paragraph => <p class="body-copy">{paragraph}</p>)}
      {variant.dante && <div class="dante-verse"><p lang="it">Nel mezzo del cammin di nostra vita<br />mi ritrovai per una selva oscura,<br />ché la diritta via era smarrita.</p><cite>——但丁《神曲·地狱篇》第一歌，第 1–3 行 · <a href="https://it.wikisource.org/wiki/Divina_Commedia/Inferno/Canto_I">阅读原文 ↗</a></cite></div>}
      <a class="home-link" href="/zh/">{variant.action} <span aria-hidden="true">→</span></a>
      {variant.aporia && <aside class="aporia-note" aria-label="认识 Aporia"><h2>Aporia <span>从困惑开始</span></h2><p>希腊语，常译为“困惑”或“无路可走”。在哲学对话中，它指追问暂时陷入困境、尚未找到答案的状态。</p><p>承认还不知道，也可以是继续思考的起点。</p><a href="https://plato.stanford.edu/archives/fall2017/entries/socrates/supplement.html">了解苏格拉底式追问 ↗</a></aside>}
      {variant.closing && <p class="closing">{variant.closing}</p>}
      {variant.boat && <svg class="odyssey" viewBox="0 0 720 240" role="img" aria-label="古希腊陶瓶风格的小船在波浪间航行"><g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round"><path d="M15 195q30-12 60 0t60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0M15 212q30-12 60 0t60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0 60 0" stroke-width="3"/><path d="M173 148h377l-27 43H219q-34-15-46-43Z" stroke-width="5"/><path d="M219 161h304M245 176h244M307 149V42" stroke-width="4"/><path d="M313 46q66 31 117 90H313ZM307 51q-47 31-63 85h63Z" stroke-width="4"/><path d="M215 148q-16-25-39-21M548 148q19-23 38-18M350 153l-9 22m35-22-9 22m35-22-9 22m35-22-9 22m35-22-9 22" stroke-width="2"/></g></svg>}
    </article>)}
    <nav class="secondary-links" aria-label="继续浏览"><a href="/zh/archive/">浏览文章馆藏</a><a href="/en/" lang="en">English home</a></nav>
  </section>
</Layout>
<script is:inline>
  const missingPage = document.getElementById('missing-page');
  if (missingPage) {
    // Explicit 404 URLs allow reviewing one design; missing URLs remain random.
    const preview = /^\/404(?:\.html)?\/?$/.test(location.pathname) ? new URLSearchParams(location.search).get('variant') : null;
    const count = Number(missingPage.dataset.count);
    missingPage.dataset.selected = preview && /^\d+$/.test(preview) && Number(preview) >= 1 && Number(preview) <= count ? String(Number(preview)) : String(1 + Math.floor(Math.random() * count));
  }
</script>
<style>
  .missing-page { max-width: 990px; min-height: 600px; padding-block: clamp(55px, 8vw, 105px); }
  .variant { display: none; }
  .variant:first-child { display: block; }
  .missing-page[data-selected] .variant { display: none; }
  .missing-page[data-selected='1'] .variant[data-variant='1'], .missing-page[data-selected='2'] .variant[data-variant='2'], .missing-page[data-selected='3'] .variant[data-variant='3'], .missing-page[data-selected='4'] .variant[data-variant='4'], .missing-page[data-selected='5'] .variant[data-variant='5'] { display: block; }
  .missing-page[data-selected='6'] .variant[data-variant='6'], .missing-page[data-selected='7'] .variant[data-variant='7'], .missing-page[data-selected='8'] .variant[data-variant='8'] { display: block; }
  .kicker { color: var(--accent); letter-spacing: .16em; font-size: 12px; font-weight: 600; margin-bottom: 32px; }
  .error-number { font: italic clamp(72px, 12vw, 132px)/1 Georgia, serif; color: var(--forest); opacity: .16; margin-bottom: 14px; }
  .odyssey-number { font-size: clamp(100px, 14vw, 160px); opacity: .65; }
  .dante-verse { margin-top: 26px; padding-block: 18px; border-block: 1px solid var(--line); max-width: 600px; }
  .dante-verse p { font: italic 17px/1.85 Georgia, serif; color: var(--forest); margin-bottom: 10px; }
  h1 { max-width: 820px; color: var(--forest); font-size: clamp(29px, 4vw, 45px); line-height: 1.55; margin-bottom: 30px; }
  .body-copy { color: var(--muted); font-size: clamp(15px, 1.7vw, 18px); line-height: 1.95; margin-bottom: 12px; }
  .home-link { display: inline-flex; align-items: center; gap: 20px; background: var(--forest); color: #f6f2e9; padding: 13px 20px; margin-top: 29px; min-height: 48px; font-size: 14px; }
  .home-link:hover { background: var(--forest-deep); }
  .closing { color: var(--accent); font: 18px/1.8 var(--serif); margin-top: 50px; }
  blockquote { border-left: 2px solid var(--accent); margin: 0 0 26px; padding: 10px 0 10px 25px; font: 19px/1.9 var(--serif); color: var(--forest); }
  cite { display: block; font: normal 12px/1.8 var(--sans); color: var(--muted); margin-top: 10px; }
  .odyssey { display: block; width: min(100%, 680px); height: auto; margin-top: 35px; color: var(--accent); }
  .socratic-heading { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 40px; align-items: center; margin-bottom: 32px; }
  .socratic-heading .error-number { font: 400 clamp(120px, 17vw, 210px)/.95 Georgia, serif; letter-spacing: -.055em; color: var(--forest); opacity: 1; margin: 0; }
  .socratic-heading h1 { font-size: clamp(28px, 3.2vw, 38px); margin: 0; text-wrap: balance; }
  .aporia-note { margin-top: 42px; padding: 24px 28px; border-left: 2px solid var(--accent); background: var(--paper); max-width: 720px; }
  .aporia-note h2 { font-size: 25px; margin-bottom: 12px; }
  .aporia-note h2 span { font: 12px var(--sans); color: var(--accent); margin-left: 16px; }
  .aporia-note p { font-size: 14px; line-height: 1.9; color: var(--muted); margin-bottom: 8px; }
  .aporia-note > a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; }
  .homer-quote { margin-bottom: 30px; }
  @media (max-width: 760px) { .socratic-heading { grid-template-columns: minmax(0, 1fr); gap: 24px; } .socratic-heading .error-number { font-size: clamp(120px, 32vw, 170px); } .aporia-note { padding: 20px; } }
  .secondary-links { display: flex; flex-wrap: wrap; gap: 12px 26px; border-top: 1px solid var(--line); margin-top: 65px; padding-top: 20px; font-size: 13px; }
  @media (max-width: 760px) { .missing-page { min-height: 510px; } .kicker { margin-bottom: 23px; } .secondary-links { margin-top: 45px; } }
</style>
