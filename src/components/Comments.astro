---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/**
 * giscus 评论系统配置(基于 GitHub Discussions,免费、无需数据库)。
 *
 * 下面四个值必须替换成你自己的,否则评论区不会工作:
 *   1. 找一个 public 的 GitHub 仓库(不需要是博客源码本身,专门建一个空仓库
 *      装评论也可以,比如 reasonforhim-comments)
 *   2. 该仓库 Settings → General → Features → 勾选 "Discussions"
 *   3. 安装 giscus GitHub App: https://github.com/apps/giscus,授权给这个仓库
 *   4. 打开 https://giscus.app,填入仓库名,页面会自动检测并生成下面四个值。
 *      Discussion 分类建议新建一个专门的(比如 "Comments"),类型选
 *      "Announcement"——这样访客只能回复、不能自己发起新 discussion,
 *      更适合当评论区用,不容易被灌水。
 *   5. 把 giscus.app 页面上生成的 data-repo / data-repo-id / data-category /
 *      data-category-id 复制过来,替换下面四个占位符。
 *
 * 注意:giscus 要求访客用 GitHub 账号登录才能评论(或者直接去 GitHub
 * Discussions 里回复)。对你的读者群体(不少是程序员/受过教育的护教/神学
 * 读者)问题不大,但如果发现很多读者因为没有 GitHub 账号而不能留言,
 * 以后可以考虑换成不要求 GitHub 登录的方案(比如 Disqus 或自建评论),
 * 这个可以以后再说。
 */
const GISCUS_REPO = 'cloudzyx123/ReasonForHim-Discussion'; // 例如 'yourname/reasonforhim-comments'
const GISCUS_REPO_ID = 'R_kgDOTuOE6A'; // 从 giscus.app 配置页复制
const GISCUS_CATEGORY = 'Comments'; // 你在仓库 Discussions 里创建的分类名
const GISCUS_CATEGORY_ID = 'DIC_kwDOTuOE6M4DCsQ2'; // 从 giscus.app 配置页复制
---

<section class="comments" id="reader-comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">{lang === 'zh' ? '读后交流' : 'Join the conversation'}</h2>
  {lang === 'zh' && <p>欢迎在微信公众号 <strong>为何是他</strong>（ID：<strong>ReasonForHim</strong>）给我留言。<a href="/subscribe/#wechat-heading">查看公众号信息 ↗</a></p>}
  <p>{lang === 'zh' ? '也可以展开 GitHub 评论，使用 GitHub 账号参与讨论。' : 'Open GitHub comments to join the discussion with a GitHub account.'} <a href={`https://github.com/${GISCUS_REPO}/discussions`}>{lang === 'zh' ? '前往讨论区 ↗' : 'Visit discussions ↗'}</a></p>
  <button type="button" data-load-comments
    data-repo={GISCUS_REPO}
    data-repo-id={GISCUS_REPO_ID}
    data-category={GISCUS_CATEGORY}
    data-category-id={GISCUS_CATEGORY_ID}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang={lang === 'zh' ? 'zh-CN' : 'en'}
    data-loading="lazy"
  >{lang === 'zh' ? '展开 GitHub 评论' : 'Open GitHub comments'}</button>
  <p class="comment-status" role="status" aria-live="polite"></p>
  <div data-comments-host></div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-load-comments]');
  const host = document.querySelector<HTMLElement>('[data-comments-host]');
  const status = document.querySelector<HTMLElement>('.comment-status');
  button?.addEventListener('click', () => {
    if (!host || !status) return;
    button.disabled = true;
    button.hidden = true;
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    for (const [key, value] of Object.entries(button.dataset)) {
      if (key === 'loadComments') continue;
      script.dataset[key] = value;
    }
    script.crossOrigin = 'anonymous';
    script.async = true;
    script.onerror = () => {
      button.disabled = false;
      button.hidden = false;
      status.textContent = button.dataset.lang === 'zh-CN'
        ? '评论暂时无法加载。你仍可通过微信公众号留言。'
        : 'Comments could not load. Please try again later.';
    };
    host.append(script);
  });
</script>

<style>
  .comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }
  h2 { font-size: 25px; margin-bottom: 12px; }
  p { color: var(--muted); font-size: 13px; line-height: 1.9; }
  a { text-decoration: underline; text-underline-offset: 4px; }
  button { border: 1px solid var(--forest); background: transparent; color: var(--forest); padding: 10px 16px; min-height: 44px; font: inherit; cursor: pointer; }
  button:hover { background: var(--paper); }
  .comment-status:empty { display: none; }
  @media print { .comments { display: none; } }
</style>
