---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../lib/i18n';
import { EDITORIAL_COVERS, getSection, SECTION_IDS, SECTIONS } from '../lib/editorial';

interface Props { lang: Lang; archiveOnly?: boolean }
const { lang, archiveOnly = false } = Astro.props;
const zh = lang === 'zh';
const posts = (await getCollection(lang, ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id)
);
const featured = posts.slice(0, 3);
const years = [...new Set(posts.map(post => post.data.pubDate.getUTCFullYear()))].sort((a, b) => b - a);
const sections = SECTION_IDS.map(id => ({
  id,
  ...SECTIONS[id][lang],
  count: posts.filter(post => getSection(post) === id).length,
}));
const date = (post: CollectionEntry<Lang>) => post.data.pubDate.toLocaleDateString(
  zh ? 'zh-CN' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }
);
const cover = (post: CollectionEntry<Lang>) => {
  const fallback = getSection(post) === 'faith' ? 'confidence-behind-rationality-science-atheism-faith-issue'
    : getSection(post) === 'literature' ? 'god-is-dead-chesterton-vs-nietzsche'
    : 'if-i-were-paralyzed-a-poems-gospel-reflection';
  return EDITORIAL_COVERS[post.id] ?? EDITORIAL_COVERS[fallback];
};
---
<Layout
  title={archiveOnly ? (zh ? '文章馆藏' : 'Essay archive') : (zh ? '首页' : 'Home')}
  description={zh ? '福音、护教、释经与神学文章，在信仰与理性的交汇处探索真理。' : 'Essays on the gospel, apologetics, Scripture, and theology. Exploring faith and reason.'}
  lang={lang}
  path={archiveOnly ? `/${lang}/archive/` : `/${lang}/`}
>
  <section class="introduction container">
    <div class="intro-copy">
      <h1>{archiveOnly ? (zh ? '文章馆藏' : 'The essay archive') : (zh ? '让思考，走向更深处。' : 'Room for a thoughtful faith.')}</h1>
      <p>{archiveOnly ? (zh ? '循着栏目、年份或一个关键词，找到想读的文字。' : 'Find your next essay by subject, year, or keyword.') : (zh ? '关于福音、文学与思想，也关于我们如何生活。' : 'On the gospel, literature, and ideas — and how we live.')}</p>
    </div>
    <div class="intro-note">
      <svg viewBox="0 0 48 58" width="34" height="42" fill="none" aria-hidden="true">
        <path d="M22 54C20 37 25 20 35 5M25 33C13 32 8 25 9 17c11 2 17 7 16 16ZM29 23C37 24 44 18 45 11c-10-1-15 4-16 12ZM22 44C12 45 5 40 3 33c10-3 18 2 19 11Z" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <p>{zh ? '慢一点阅读，深一点思考。' : 'Read slowly. Think deeply.'}</p>
    </div>
  </section>

  <div class="container">
    {!archiveOnly && featured.length > 0 && (
      <section class="featured-section" aria-labelledby="featured-heading">
        <div class="section-heading">
          <h2 id="featured-heading">{zh ? '书房选读' : 'From the reading room'}</h2>
          <a class="text-link" href="#articles">{zh ? '浏览全部文章' : 'All essays'} <span aria-hidden="true">→</span></a>
        </div>
        <div class="featured-grid">
          {featured.map((post, index) => (
            <article class:list={['featured-card', { 'lead-story': index === 0 }]}>
              <div class="story-copy">
                <div class="card-meta">
                  <a href={`/${lang}/archive/?section=${getSection(post)}#articles`}>{SECTIONS[getSection(post)][lang].title}</a>
                  <time datetime={post.data.pubDate.toISOString()}>{date(post)}</time>
                </div>
                <h3><a href={`/${lang}/${post.id}/`}>{post.data.title}</a></h3>
                <p class="card-description">{post.data.description}</p>
                {index === 0 && <a class="text-link lead-read" href={`/${lang}/${post.id}/`}>{zh ? '开始阅读' : 'Read the essay'} <span aria-hidden="true">→</span></a>}
              </div>
              <a class="cover-link" href={`/${lang}/${post.id}/`} aria-label={post.data.title}>
                <img
                  src={cover(post).src}
                  srcset={`${cover(post).src.replace('.webp', '-600.webp')} 600w, ${cover(post).src} 1200w`}
                  sizes={index === 0 ? '(max-width: 760px) calc(100vw - 40px), (max-width: 1240px) 55vw, 680px' : '(max-width: 760px) calc(100vw - 40px), (max-width: 1240px) 34vw, 405px'}
                  alt={cover(post)[lang]}
                  width="1200"
                  height="800"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <div class="archive-layout">
      <section id="articles" class="archive" aria-labelledby="archive-heading" data-archive data-lang={lang} data-section-labels={JSON.stringify(Object.fromEntries(sections.map(section => [section.id, section.title])))}>
        <div class="section-heading archive-heading">
          <div><p class="section-kicker">{zh ? '在文字之间，继续探寻' : 'Keep exploring'}</p><h2 id="archive-heading">{zh ? '全部文章' : 'The essay collection'}</h2></div>
          <span class="archive-total">{zh ? `共 ${posts.length} 篇` : `${posts.length} essays`}</span>
        </div>
        <nav class="archive-chips" aria-label={zh ? '选择文章栏目' : 'Choose an essay section'}>
          <a href={`/${lang}/archive/#articles`} data-section="">{zh ? '全部' : 'All'}</a>
          {sections.map(section => <a href={`/${lang}/archive/?section=${section.id}#articles`} data-section={section.id}>{section.title}</a>)}
        </nav>
        <form class="archive-search" role="search">
          <label class="sr-only" for="archive-query">{zh ? '在文章中搜索' : 'Search this collection'}</label>
          <input id="archive-query" type="search" name="q" placeholder={zh ? '输入标题、摘要或关键词' : 'Search titles, descriptions, or keywords'} />
          <button type="submit">{zh ? '搜索' : 'Search'} <span aria-hidden="true">→</span></button>
        </form>
        <div class="archive-options">
          <label>{zh ? '年份' : 'Year'}<select data-year aria-label={zh ? '按年份浏览' : 'Browse by year'}><option value="">{zh ? '全部年份' : 'All years'}</option>{years.map(year => <option value={String(year)}>{year}</option>)}</select></label>
          <label>{zh ? '排序' : 'Sort'}<select data-order aria-label={zh ? '文章排序' : 'Sort essays'}><option value="newest">{zh ? '最新在前' : 'Newest first'}</option><option value="oldest">{zh ? '最早在前' : 'Oldest first'}</option></select></label>
        </div>
        <div class="filter-status">
          <p data-result-count aria-live="polite">{zh ? '按发布时间排序' : 'Most recent first'}</p>
          <button type="button" data-reset hidden>{zh ? '清除筛选 ×' : 'Clear filters ×'}</button>
        </div>
        <div class="essay-list">
          {posts.map((post, index) => (
            <article class="essay-row" data-post data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${SECTIONS[getSection(post)][lang].title}`.toLocaleLowerCase()} data-tags={JSON.stringify(post.data.tags)} data-section-id={getSection(post)} data-year={String(post.data.pubDate.getUTCFullYear())} data-date={post.data.pubDate.toISOString()}>
              <span class="essay-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <div class="row-meta"><time datetime={post.data.pubDate.toISOString()}>{date(post)}</time><span>{SECTIONS[getSection(post)][lang].title}</span></div>
                <h3><a href={`/${lang}/${post.id}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
              <a class="row-arrow" href={`/${lang}/${post.id}/`} aria-label={`${zh ? '阅读：' : 'Read: '}${post.data.title}`}>↗</a>
            </article>
          ))}
        </div>
        <div class="empty-state" data-empty hidden={posts.length > 0}>
          <h3>{posts.length ? (zh ? '没有找到相关文章' : 'No matching essays') : (zh ? '文章即将刊载' : 'Essays are on their way')}</h3>
          <p>{posts.length ? (zh ? '试试其他关键词，或清除筛选查看全部文章。' : 'Try another keyword, or clear the filters to see all essays.') : (zh ? '你可以先浏览其他语言的文章。' : 'In the meantime, explore the Chinese essay collection.')}</p>
          {!posts.length && <a class="text-link" href={zh ? '/en/' : '/zh/'}>{zh ? '浏览英文文章 →' : 'Explore Chinese essays →'}</a>}
        </div>
      </section>

      <aside class="sidebar">
        <section id="topics" class="sections-panel" aria-labelledby="sections-heading">
          <h2 id="sections-heading">{zh ? '阅读栏目' : 'Reading by subject'}</h2>
          <nav class="section-list" aria-label={zh ? '按栏目浏览文章' : 'Browse essays by section'}>
            {sections.map(section => (
              <a href={`/${lang}/archive/?section=${section.id}#articles`} data-section={section.id}>
                <span><strong>{section.title}</strong><small>{section.description}</small></span>
                <span class="section-count">{String(section.count).padStart(2, '0')}</span>
              </a>
            ))}
          </nav>
        </section>
        <section id="about" class="about-panel">
          <p class="section-kicker">{zh ? '关于这间书房' : 'About this reading room'}</p>
          <h2>{zh ? '为何是祂' : 'Reason for Him'}</h2>
          <span class="small-rule" aria-hidden="true"></span>
          <p>{zh ? '信仰的起点，可以是一个诚实的问题。' : 'An honest question can be the beginning of faith.'}</p>
          <p>{zh ? '这里收录关于福音、护教、释经与神学的文字，也关注文学与思想中的信仰回声。愿每一次阅读，都成为更深认识的开始。' : 'A collection of writing on the gospel, apologetics, Scripture, and theology, with an ear for the echoes of faith in literature and ideas.'}</p>
          <a class="text-link" href={`/${lang}/rss.xml`}>{zh ? '通过 RSS 订阅' : 'Follow via RSS'} <span aria-hidden="true">↗</span></a>
        </section>
      </aside>
    </div>
    <div class="closing-note"><span aria-hidden="true">✳</span><p>{zh ? '愿每一次阅读，都通往更深的认识。' : 'May every reading open a deeper understanding.'}</p></div>
  </div>
</Layout>

<script>
  const archive = document.querySelector<HTMLElement>('[data-archive]');
  if (archive) {
    const input = document.querySelector<HTMLInputElement>('#archive-query')!;
    const navInput = document.querySelector<HTMLInputElement>('#site-search');
    const rows = Array.from(archive.querySelectorAll<HTMLElement>('[data-post]'));
    const count = archive.querySelector<HTMLElement>('[data-result-count]')!;
    const reset = archive.querySelector<HTMLButtonElement>('[data-reset]')!;
    const empty = archive.querySelector<HTMLElement>('[data-empty]')!;
    const zh = archive.dataset.lang === 'zh';
    const yearSelect = archive.querySelector<HTMLSelectElement>('[data-year]')!;
    const orderSelect = archive.querySelector<HTMLSelectElement>('[data-order]')!;
    const list = archive.querySelector<HTMLElement>('.essay-list')!;
    const sectionLabels: Record<string, string> = JSON.parse(archive.dataset.sectionLabels ?? '{}');
    let topic = '';
    let section = '';

    function readParams() {
      const params = new URLSearchParams(location.search);
      topic = params.get('topic') ?? '';
      section = params.get('section') ?? '';
      input.value = params.get('q') ?? '';
      yearSelect.value = params.get('year') ?? '';
      orderSelect.value = params.get('sort') === 'oldest' ? 'oldest' : 'newest';
    }

    function filter(updateUrl = true, push = false) {
      const query = input.value.trim().toLocaleLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      let visible = 0;
      const ordered = [...rows].sort((a, b) => {
        const comparison = (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '') || (a.dataset.search ?? '').localeCompare(b.dataset.search ?? '');
        return orderSelect.value === 'oldest' ? comparison : -comparison;
      });
      for (const row of ordered) {
        const tags: string[] = JSON.parse(row.dataset.tags ?? '[]');
        row.hidden = !terms.every(term => row.dataset.search?.includes(term))
          || (!!topic && !tags.includes(topic))
          || (!!section && row.dataset.sectionId !== section)
          || (!!yearSelect.value && row.dataset.year !== yearSelect.value);
        list.append(row);
        if (!row.hidden) { visible++; row.querySelector('.essay-number')!.textContent = String(visible).padStart(2, '0'); }
      }
      if (navInput) navInput.value = input.value;
      const label = [sectionLabels[section] ?? section, topic, yearSelect.value].filter(Boolean).join(' · ');
      const active = !!query || !!topic || !!section || !!yearSelect.value;
      count.textContent = active
        ? `${label ? `${label} · ` : ''}${zh ? `找到 ${visible} 篇文章` : `${visible} essays found`}`
        : (orderSelect.value === 'oldest' ? (zh ? '最早的文章在前' : 'Oldest first') : (zh ? '按发布时间排序' : 'Most recent first'));
      reset.hidden = !active;
      empty.hidden = visible > 0;
      document.querySelectorAll<HTMLAnchorElement>('[data-section]').forEach(link => {
        if (link.dataset.section === section) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      if (updateUrl) {
        const url = new URL(location.href);
        query ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
        topic ? url.searchParams.set('topic', topic) : url.searchParams.delete('topic');
        section ? url.searchParams.set('section', section) : url.searchParams.delete('section');
        yearSelect.value ? url.searchParams.set('year', yearSelect.value) : url.searchParams.delete('year');
        orderSelect.value === 'oldest' ? url.searchParams.set('sort', 'oldest') : url.searchParams.delete('sort');
        if (push) url.hash = 'articles';
        if (url.href !== location.href) { if (push) history.pushState(null, '', url); else history.replaceState(null, '', url); }
      }
    }
    input.addEventListener('input', () => filter());
    archive.querySelector('form')?.addEventListener('submit', event => { event.preventDefault(); filter(); });
    document.querySelector('.nav-search')?.addEventListener('submit', event => {
      event.preventDefault();
      input.value = navInput?.value ?? '';
      filter();
      archive.scrollIntoView({ block: 'start' });
      input.focus({ preventScroll: true });
    });
    reset.addEventListener('click', () => { input.value = ''; topic = ''; section = ''; yearSelect.value = ''; orderSelect.value = 'newest'; filter(true, true); });
    yearSelect.addEventListener('change', () => filter(true, true));
    orderSelect.addEventListener('change', () => filter(true, true));
    document.querySelectorAll<HTMLAnchorElement>('[data-section]').forEach(link => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      section = link.dataset.section ?? '';
      topic = '';
      filter(true, true);
      archive.scrollIntoView({ block: 'start' });
    }));
    window.addEventListener('popstate', () => { readParams(); filter(false); });
    readParams();
    filter(false);
  }
</script>

<style>
  .archive-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .archive-chips a { display: inline-flex; align-items: center; padding: 7px 12px; min-height: 40px; font-size: 12px; border: 1px solid var(--line); }
  .archive-chips a[aria-current] { background: var(--forest); color: #f6f2e9; border-color: var(--forest); }
  .archive-options { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 16px; }
  .archive-options label { display: flex; gap: 10px; align-items: center; color: var(--muted); font-size: 12px; }
  .archive-options select { border: 1px solid var(--line); background: var(--paper); color: var(--forest); font: inherit; padding: 7px 26px 7px 10px; min-height: 40px; }
  @media (max-width: 760px) { .archive-chips a { min-height: 44px; } .archive-options select { font-size: 16px; min-height: 44px; } .archive-search input { font-size: 16px !important; } }

  .introduction { display: flex; align-items: center; justify-content: space-between; gap: 36px; padding-block: 27px 31px; border-bottom: 1px solid var(--line); }
  .intro-copy h1 { font-size: 36px; letter-spacing: .035em; margin-bottom: 9px; }
  .intro-copy > p { font-size: 14px; color: var(--muted); margin: 0; }
  .intro-note { display: flex; gap: 17px; align-items: center; color: var(--accent); padding-left: 28px; border-left: 1px solid var(--line); }
  .intro-note p { font: 16px/1.9 var(--serif); color: var(--muted); margin: 0; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
  .section-heading h2 { font-size: 25px; margin: 0; letter-spacing: .04em; }
  .featured-section { padding-block: 27px 45px; border-bottom: 1px solid var(--line); }
  .featured-grid { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 26px 36px; }
  .featured-card { min-width: 0; }
  .lead-story { grid-row: span 2; border-right: 1px solid var(--line); padding-right: 36px; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 9px 20px; color: var(--muted); font-size: 12px; margin-bottom: 9px; }
  .card-meta a { color: var(--accent); }
  .featured-card h3 { font-size: 23px; line-height: 1.6; margin-bottom: 12px; overflow-wrap: anywhere; }
  .lead-story h3 { font-size: 32px; line-height: 1.6; margin-bottom: 12px; }
  .card-description { font-size: 14px; line-height: 1.9; color: var(--muted); margin-bottom: 18px; }
  .lead-read { display: inline-block; margin-bottom: 23px; }
  .cover-link { display: block; overflow: hidden; background: var(--paper); aspect-ratio: 2.25; }
  .cover-link img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lead-story .cover-link { aspect-ratio: 1.5; }
  .featured-card:not(.lead-story) { display: flex; flex-direction: column; }
  .featured-card:not(.lead-story) .cover-link { order: -1; margin-bottom: 15px; }
  .featured-card:not(.lead-story) + .featured-card { border-top: 1px solid var(--line); padding-top: 26px; }
  .featured-card:not(.lead-story) .card-description { font-size: 13px; margin-bottom: 0; }
  .archive-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 64px; padding-top: 43px; }
  .archive, .sections-panel, .about-panel { scroll-margin-top: 24px; }
  .archive-heading { margin-bottom: 23px; }
  .section-kicker { font-size: 12px; color: var(--muted); margin-bottom: 9px; letter-spacing: .03em; }
  .archive-total { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .archive-search { display: flex; border: 1px solid var(--line); min-height: 46px; }
  .archive-search input { border: 0; min-width: 0; flex: 1; background: transparent; font-size: 14px; padding: 10px 14px; color: var(--ink); }
  .archive-search button { border: 0; border-left: 1px solid var(--line); background: var(--paper); color: var(--forest); padding: 8px 18px; font-size: 13px; }
  .archive-search button span { margin-left: 14px; }
  .filter-status { display: flex; justify-content: space-between; gap: 12px; min-height: 50px; align-items: center; font-size: 12px; color: var(--muted); }
  .filter-status p { margin: 0; }
  .filter-status button { border: 0; background: none; color: var(--forest); font-size: 12px; padding: 6px 0; }
  .essay-row { border-top: 1px solid var(--line); padding: 26px 0; display: grid; grid-template-columns: 26px minmax(0, 1fr) 22px; gap: 17px; }
  .essay-number { font: italic 17px var(--serif); color: #7d877b; padding-top: 4px; }
  .row-meta { display: flex; flex-wrap: wrap; gap: 7px 16px; color: var(--muted); font-size: 12px; margin-bottom: 10px; }
  .row-meta > span { color: var(--accent); }
  .essay-row h3 { font-size: 23px; line-height: 1.65; margin-bottom: 10px; overflow-wrap: anywhere; }
  .essay-row p { font-size: 14px; color: var(--muted); line-height: 1.9; margin: 0; }
  .row-arrow { font-size: 22px; align-self: center; }
  .sidebar h2 { font-size: 23px; margin-bottom: 21px; }
  .section-list { border-top: 2px solid var(--forest); }
  .section-list a { display: flex; justify-content: space-between; gap: 15px; align-items: baseline; border-bottom: 1px solid var(--line); padding-block: 17px; }
  .section-list strong { display: block; font: 500 18px/1.7 var(--serif); }
  .section-list small { display: block; font-size: 12px; line-height: 1.85; color: var(--muted); margin-top: 4px; }
  .section-list a:hover { text-decoration: none; }
  .section-list a:hover strong { text-decoration: underline; text-underline-offset: 5px; }
  .section-list a[aria-current] strong { color: var(--accent); }
  .section-count { font: italic 15px var(--serif); color: var(--muted); }
  .about-panel { background: var(--paper); padding: 25px; margin-top: 34px; }
  .small-rule { display: block; width: 28px; border-top: 2px solid var(--accent); margin-bottom: 21px; }
  .about-panel p:not(.section-kicker) { font-size: 14px; line-height: 1.95; color: #53624f; }
  .about-panel .text-link { display: inline-block; margin-top: 6px; }
  .closing-note { border-top: 1px solid var(--line); text-align: center; margin-top: 44px; padding-top: 35px; }
  .closing-note span { font-size: 27px; color: var(--accent); }
  .closing-note p { font: 17px/1.9 var(--serif); color: var(--muted); margin: 10px 0 0; }
  .empty-state { text-align: center; padding: 55px 18px; border-top: 1px solid var(--line); }
  .empty-state h3 { font-size: 24px; }
  .empty-state p { color: var(--muted); font-size: 14px; }
  [hidden] { display: none !important; }

  @media (max-width: 1000px) and (min-width: 761px) {
    .intro-copy h1 { font-size: 31px; }
    .intro-note { max-width: 240px; padding-left: 20px; }
    .featured-grid { gap: 24px; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); }
    .lead-story { padding-right: 24px; }
    .lead-story h3 { font-size: 28px; }
    .archive-layout { gap: 32px; grid-template-columns: minmax(0, 1fr) 250px; }
  }
  @media (max-width: 760px) {
    .introduction { padding-block: 23px 25px; }
    .intro-copy h1 { font-size: 27px; line-height: 1.65; }
    .intro-copy > p { font-size: 13px; line-height: 1.9; }
    .intro-note { display: none; }
    .section-heading { margin-bottom: 21px; gap: 10px; }
    .section-heading h2 { font-size: 23px; }
    .section-heading > .text-link { font-size: 12px; white-space: nowrap; }
    .featured-section { padding-block: 24px 30px; }
