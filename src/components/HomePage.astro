---
import { publicDir } from 'astro:config/server';
import Layout from '../layouts/Layout.astro';
import EssayRow from './EssayRow.astro';
import { AUTHOR_EMAIL, type Lang } from '../lib/i18n';
import { FEATURED_ARTICLES, getSection, SECTIONS } from '../lib/editorial';
import { selectHomeReading } from '../lib/article-list.mjs';
import { catalogue, formatEssayDate } from '../lib/catalogue';
import { listCoverResolver } from '../lib/list-covers';

interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const otherLang = zh ? 'en' : 'zh';
const archive = `/${lang}/archive/`;
const { posts, sections } = await catalogue(lang);
const { cover: lead, recent } = selectHomeReading(posts, FEATURED_ARTICLES[lang]);
const resolveCover = listCoverResolver(publicDir, lang);
const image = lead && await resolveCover(lead, 'home');
const coverSizes = '(max-width: 640px) calc(100vw - 40px), (max-width: 760px) 46vw, (max-width: 1240px) calc((100vw - 80px) * .48), 550px';
---
<Layout
  title={zh ? '信仰、理性与文学｜基督教护教与思想文章' : 'Home'}
  description={zh
    ? '从路易斯笔下的神话，到人工智能带来的信仰之问，这间书房收录基督教护教、文学评论与圣经研读文章。'
    : 'Start with featured and recent essays from Reason for Him on the gospel, questions of belief, and Christian faith in everyday life.'}
  {lang} path={`/${lang}/`} alternates={[{ lang: otherLang, href: `/${otherLang}/` }]}
>
  <div class="container reading-room">
    <section aria-labelledby="featured-heading">
      <h1 class="rubric" id="featured-heading">{zh ? '信仰、理性与文学选读' : 'From the reading room'}</h1>
      {lead ? (
        <article class:list={['cover', { 'type-cover': !image }]}>
          <a href={`/${lang}/${lead.id}/`} aria-labelledby="cover-title" class="cover-link">
            <div class="cover-copy">
              <div class="meta">
                <span>{SECTIONS[getSection(lead)][lang].title}</span>
                <time datetime={lead.data.pubDate.toISOString()}>{formatEssayDate(lead.data.pubDate, lang)}</time>
              </div>
              <h2 id="cover-title">{lead.data.title}</h2>
              <p>{lead.data.description}</p>
              <span class="read">{zh ? '开始阅读' : 'Read the essay'} <span aria-hidden="true">→</span></span>
            </div>
            {image && <div class="plate">
              <img src={image.src} alt={image.alt} width={image.width} height={image.height}
                sizes={coverSizes} data-essay-cover={coverSizes} loading="eager" fetchpriority="high"
                decoding="async" style={{ 'object-position': image.position }} />
            </div>}
          </a>
        </article>
      ) : (
        <div class="empty">
          <h2>{zh ? '文章即将刊载' : 'Essays are on their way'}</h2>
          <a class="destination" href={`/${otherLang}/`}>{zh ? '浏览英文文章 →' : 'Explore Chinese essays →'}</a>
        </div>
      )}
    </section>

    <div id="articles" class:list={['recent', { compact: !recent.length }]}>
      {recent.length > 0 && <section class="index" aria-labelledby="recent-heading">
        <h2 id="recent-heading">{zh ? '近期文章' : 'Recent Essays'}</h2>
        <div class="rows">
          {recent.map(async post => <EssayRow {lang} {post} cover={await resolveCover(post, 'home')} />)}
        </div>
      </section>}
      <a class="destination archive-link" href={archive}>
        {zh ? `进入馆藏 · 共 ${posts.length} 篇` : `Explore the archive · ${posts.length} ${posts.length === 1 ? 'essay' : 'essays'}`}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <section class="subjects" id="topics" aria-labelledby="subjects-heading">
      <h2 id="subjects-heading">{zh ? '阅读栏目' : 'Reading by subject'}</h2>
      <nav aria-labelledby="subjects-heading">
        {sections.map(section => <a href={`${archive}?section=${section.id}#articles`}>
          <span class="subject-line"><strong>{section.title}</strong><small>{zh ? `${section.count} 篇` : `${section.count} ${section.count === 1 ? 'essay' : 'essays'}`}</small></span>
          <span class="gloss">{section.description}</span>
        </a>)}
      </nav>
    </section>

    <section class="about" id="about" aria-labelledby="about-heading">
      <img src="/images/editorial/dialogue-600.webp" width="600" height="400" alt="" loading="lazy" decoding="async" />
      <div>
        <h2 id="about-heading">{zh ? '关于这间书房' : 'About this reading room'}</h2>
        <p>{zh ? '这里收录关于福音、护教、释经与神学的文字，也关注文学与思想中的信仰回声。' : 'A collection of writing on the gospel, apologetics, Scripture, and theology, with an ear for the echoes of faith in literature and ideas.'}</p>
        <p class="write-invitation">{zh
          ? <>如果哪篇文章让你想到一个问题，或有不同的看法，欢迎<a href={`mailto:${AUTHOR_EMAIL}`}>给我写信</a>。</>
          : <>If an essay brings a question to mind or you see things differently, I’d love to hear from you. <a href={`mailto:${AUTHOR_EMAIL}`}>Write to me</a>.</>}</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .reading-room { padding-top: 28px; }
  .rubric { display: flex; align-items: center; gap: 16px; margin: 0; font: 600 14px/1.5 var(--sans); letter-spacing: .1em; color: var(--accent); }
  .rubric::after { content: ''; flex: 1; border-top: 1px solid var(--line); }
  .cover { padding-block: 24px 34px; }
  .cover-link { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .96fr); gap: clamp(24px, 5vw, 72px); align-items: center; }
  .cover-link:hover, .subjects a:hover { text-decoration: none; }
  .cover-link:hover h2, .subjects a:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .15em; }
  .meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: 5px 14px; font-size: 13px; color: var(--muted); }
  .meta span { color: var(--accent); }
  .cover h2 { font-size: clamp(30px, 3.4vw, 50px); line-height: 1.25; text-wrap: balance; overflow-wrap: anywhere; margin: 14px 0; }
  :global(html[lang='zh-Hans']) .cover h2 { letter-spacing: .025em; line-height: 1.4; }
  .cover-copy p { max-width: 52ch; color: var(--muted); font-size: 16px; line-height: 1.85; margin: 0 0 16px; }
  .read, .destination { display: inline-flex; align-items: center; gap: 16px; font-size: 14px; font-weight: 600; min-height: 44px; }
  .read { border-bottom: 1px solid var(--accent); }
  .plate { aspect-ratio: 3 / 2; background: var(--paper); }
  .plate img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .type-cover .cover-link { display: block; max-width: 820px; padding: 12px 0; }
  .type-cover h2 { font-size: clamp(32px, 4vw, 56px); }
  .empty { padding-block: 32px; }
  .recent, .subjects, .about { scroll-margin-top: 20px; }
  .recent, .subjects { border-top: 1px solid var(--forest); padding-block: 24px 30px; }
  .index { display: grid; grid-template-columns: minmax(165px, 1fr) minmax(0, 3.4fr); gap: 32px; }
  .index h2, .subjects h2, .about h2 { font-size: 26px; line-height: 1.35; margin: 0; }
  .rows :global(.essay-row:first-child) { padding-top: 0; border-top: 0; }
  .rows :global(.essay-link:not(:has(img))) { display: block; }
  .rows :global(.essay-cover:not(:has(img))) { display: none; }
  .archive-link { display: flex; width: fit-content; margin-left: auto; }
  .compact { padding-block: 6px; }
  .subjects nav { margin-top: 20px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .subjects a { border-top: 1px solid var(--line); padding-block: 14px 6px; }
  .subject-line { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .subject-line strong { font: 500 19px/1.35 var(--serif); }
  .subject-line small, .gloss { color: var(--muted); font-size: 13px; }
  .subject-line small { white-space: nowrap; }
  .gloss { display: block; margin-top: 6px; }
  .about { display: grid; grid-template-columns: 154px minmax(0, 1fr); align-items: center; gap: 28px; background: var(--paper); padding: 22px 28px; }
  .about img { display: block; }
  .about h2 { font-size: 23px; }
  .about p { max-width: 74ch; margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .write-invitation a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1000px) {
    .subjects nav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; }
    .index { display: block; }
    .index h2 { margin-bottom: 20px; }
  }
  @media (max-width: 640px) {
    .reading-room { padding-top: 18px; }
    .cover { padding-block: 16px 24px; }
    .cover-link { grid-template-columns: 1fr; gap: 16px; }
    .plate { grid-row: 1; max-height: 230px; width: 100%; }
    .cover h2 { margin-block: 8px; }
    .cover-copy p { font-size: 15px; margin-bottom: 4px; }
    .recent, .subjects { padding-block: 18px; }
    .compact { padding-block: 4px; }
    .index h2, .subjects h2 { font-size: 23px; }
    .subjects nav { grid-template-columns: 1fr; gap: 0; margin-top: 12px; }
    .subjects a { padding-block: 10px; }
    .gloss { margin-top: 2px; }
    .about { grid-template-columns: 1fr; padding: 18px; position: relative; }
    .about img { position: absolute; top: 12px; right: 16px; width: 56px; }
    .about h2 { padding-right: 56px; font-size: 20px; }
    .about p { margin-top: 16px; }
  }
</style>
