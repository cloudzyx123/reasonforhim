---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../lib/i18n';
import type { listCoverResolver } from '../lib/list-covers';
import { getSection, SECTIONS } from '../lib/editorial';
import { formatEssayDate } from '../lib/catalogue';

interface Props {
  post: CollectionEntry<Lang>;
  lang: Lang;
  cover: Awaited<ReturnType<ReturnType<typeof listCoverResolver>>>;
}
const { post, lang, cover } = Astro.props;
const section = SECTIONS[getSection(post)][lang].title;
const thumbnailSizes = '(max-width: 360px) 88px, (max-width: 760px) 96px, 128px';
---
<article class="essay-row" data-post={post.id} data-tags={JSON.stringify(post.data.tags)} data-section-id={getSection(post)} data-year={String(post.data.pubDate.getUTCFullYear())} data-date={post.data.pubDate.toISOString()}>
  <a class="essay-link" href={`/${lang}/${post.id}/`} aria-labelledby={`essay-${post.id}`}>
    <div class="essay-cover">
      {cover && <img src={cover.src} srcset={cover.srcset} sizes={cover.srcset && thumbnailSizes} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" style={{ 'object-position': cover.position, 'object-fit': cover.fit }} data-essay-thumbnail={thumbnailSizes} />}
    </div>
    <div>
      <div class="row-meta"><time datetime={post.data.pubDate.toISOString()}>{formatEssayDate(post.data.pubDate, lang)}</time><span>{section}</span></div>
      <h3 id={`essay-${post.id}`}>{post.data.title}</h3>
      <p>{post.data.description}</p>
    </div>
  </a>
</article>
<style>
  .essay-row { border-top: 1px solid var(--line); padding-block: 18px; }
  .essay-link { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 20px; align-items: start; }
  .essay-link:hover { text-decoration: none; }
  .essay-link:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  .essay-cover { aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper); border: 1px solid var(--line); }
  .essay-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .row-meta { display: flex; flex-wrap: wrap; gap: 2px 12px; color: var(--muted); font-size: 12px; margin-bottom: 4px; }
  .row-meta > span { color: var(--accent); }
  .essay-row h3 { font-size: 22px; line-height: 1.45; margin-bottom: 4px; overflow-wrap: anywhere; }
  .essay-row p { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; font-size: 14px; color: var(--muted); line-height: 1.65; margin: 0; }
  .essay-row[data-match] p { display: block; }
  .essay-row :global(mark) { color: var(--ink); background: #f1dfac; }
  @media (max-width: 760px) {
    .essay-row { padding-block: 15px; }
    .essay-link { gap: 12px; grid-template-columns: 96px minmax(0, 1fr); }
    .essay-row h3 { font-size: 18px; }
    .essay-row p { font-size: 13px; -webkit-line-clamp: 3; }
  }
  @media (max-width: 360px) { .essay-link { grid-template-columns: 88px minmax(0, 1fr); } }
</style>
