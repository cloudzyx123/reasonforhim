{
  "name": "my-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "cms:check": "node scripts/check-pages-cms.mjs",
    "prebuild": "node scripts/check-pages-cms.mjs",
    "article:prepare": "node scripts/prepare-blog-post.mjs",
    "test": "npm run build && node --test scripts/*.test.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/position-built-footnotes.mjs && node scripts/enhance-public-images.mjs && node scripts/check-built-links.mjs && node --test scripts/footnotes.test.mjs scripts/share.test.mjs scripts/share-interaction.test.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "parse5": "^7.3.0",
    "sharp": "0.35.5",
    "twitter-text": "3.1.0"
  }
}
